# Frontend Port
VITE_PORT=5174

# Backend Configuration
PORT=8001
HOST=0.0.0.0

# Database Configuration (PostgreSQL Container)
POSTGRES_USER=deeplearning
POSTGRES_PASSWORD=deeplearning_secret
POSTGRES_DB=movierec_db
POSTGRES_HOST=database
POSTGRES_PORT=5432
DATABASE_URL=postgresql://deeplearning:deeplearning_secret@database:5432/movierec_db

# Release metadata shown in the UI header/footer and GET /api/health
# e.g. GIT_COMMIT_SHA=$(git rev-parse HEAD) docker compose up --build -d
GIT_COMMIT_SHA=unknown
RELEASE_ENV=local
